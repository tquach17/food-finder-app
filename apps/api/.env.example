# Google Places API (venue discovery + ratings)
# Get yours FREE: https://console.cloud.google.com/
# Enable: Places API
# Free credit: $200/month
GOOGLE_PLACES_API_KEY=your_key_here

# YouTube Data API v3 (social trend signals)
# Get yours FREE: https://console.cloud.google.com/
# Enable: YouTube Data API v3
# Free quota: 10,000 units/day
YOUTUBE_API_KEY=your_key_here

# TikTok (user OAuth only)
# USERS connect voluntarily - add when ready
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Redis (optional - skipped if not running)
REDIS_URL=redis://localhost:6379

# PostgreSQL (optional)
DATABASE_URL=postgresql://user:password@localhost:5432/bitemap

PORT=3000
NODE_ENV=development
